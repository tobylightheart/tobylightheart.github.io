source 'https://rubygems.org'

# GitHub Pages builds this site server-side with its own pinned gem set; this
# Gemfile exists only for local `bundle exec jekyll serve`. Gemfile.lock is
# deliberately NOT committed: Pages ignores it, nothing else consumed it, and
# committing it meant Dependabot raising a PR per CVE against a 271-line 2021
# dependency tree that never runs in the deployment. Run `bundle install`
# locally and you get current gems, which is what Pages approximates anyway.
gem 'github-pages', group: :jekyll_plugins
